<%# locals: (business:) %>
<div class="bg-white px-4 py-5 shadow-sm ring-1 ring-slate-900/5 sm:rounded-xl sm:px-6"
     data-controller="work-status-form">
  <div class="mb-4 flex items-center justify-between gap-3">
    <h3 class="text-base font-semibold leading-6 text-slate-900">Work status</h3>
    <%= render "admin/shared/business_work_status_badge", business: business %>
  </div>

  <% if business.employee_report.present? %>
    <div class="mb-4 rounded-lg bg-amber-50 p-3 ring-1 ring-inset ring-amber-200">
      <p class="text-xs font-semibold uppercase tracking-wide text-amber-800">Employee report</p>
      <p class="mt-1 whitespace-pre-wrap text-sm text-amber-900"><%= business.employee_report %></p>
    </div>
  <% end %>

  <% if business.completion_notes.present? %>
    <div class="mb-4 rounded-lg bg-emerald-50 p-3 ring-1 ring-inset ring-emerald-200">
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-800">Completion notes</p>
      <p class="mt-1 whitespace-pre-wrap text-sm text-emerald-900"><%= business.completion_notes %></p>
    </div>
  <% end %>

  <%= form_with url: update_work_status_admin_business_path(business), method: :patch, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= label_tag :work_status, "Update status", class: "block text-sm font-medium text-slate-900" %>
      <%= select_tag :work_status,
            options_for_select(Business::WORK_STATUSES.map { |k, v| [v, k] }, business.work_status),
            class: "mt-1 block w-full rounded-lg border-0 px-3 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm",
            data: { work_status_form_target: "status", action: "change->work-status-form#toggle" } %>
    </div>

    <div data-work-status-form-target="reportField" class="<%= business.work_status == 'done' ? '' : 'hidden' %>">
      <%= label_tag :employee_report, "Process report", class: "block text-sm font-medium text-slate-900" %>
      <%= text_area_tag :employee_report, business.employee_report,
            rows: 4,
            class: "mt-1 block w-full rounded-lg border-0 px-3 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm",
            placeholder: "Summarize calls, outcome, and next steps..." %>
      <p class="mt-1 text-xs text-slate-500">Required when status is Done.</p>
    </div>

    <div data-work-status-form-target="notesField" class="<%= business.work_status == 'completed' ? '' : 'hidden' %>">
      <%= label_tag :completion_notes, "Admin completion notes", class: "block text-sm font-medium text-slate-900" %>
      <%= text_area_tag :completion_notes, business.completion_notes,
            rows: 4,
            class: "mt-1 block w-full rounded-lg border-0 px-3 py-2.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm",
            placeholder: "Add closing notes about this business..." %>
      <p class="mt-1 text-xs text-slate-500">Required when status is Completed.</p>
    </div>

    <%= f.submit "Save status", class: "rounded-md bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  <% end %>
</div>
