<%# locals: (business:) %>
<%
  classes = case business.work_status
  when "assigned" then "bg-slate-50 text-slate-700 ring-slate-600/20"
  when "in_progress" then "bg-blue-50 text-blue-700 ring-blue-600/20"
  when "done" then "bg-amber-50 text-amber-700 ring-amber-600/20"
  when "completed" then "bg-emerald-50 text-emerald-700 ring-emerald-600/20"
  else "bg-sand-50 text-sand-600 ring-sand-300"
  end
%>
<span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= classes %>">
  <%= business.work_status_label %>
</span>
