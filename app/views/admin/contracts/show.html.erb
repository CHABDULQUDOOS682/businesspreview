<% content_for :title, "#{@contract.title} · #{@business.name}" %>

<div class="mx-auto max-w-3xl space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <%= link_to "← Back to business", admin_business_path(@business), class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
      <h1 class="mt-2 text-2xl font-bold text-slate-900"><%= @contract.title %></h1>
      <p class="mt-1 text-sm text-slate-500">
        <%= @contract.kind_label %>
        <% if @contract.package_label.present? %> · <%= @contract.package_label %><% end %>
        · <%= @contract.status_label %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Download PDF", download_admin_business_contract_path(@business, @contract), class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-900 ring-1 ring-inset ring-slate-300" %>
      <%= button_to "Sync to SitePilot", sync_to_sitepilot_admin_business_contract_path(@business, @contract), method: :post, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-900 ring-1 ring-inset ring-slate-300 hover:bg-slate-50" %>
      <% if @contract.draft? || @contract.sent? %>
        <%= button_to "Send for signature", send_for_signature_admin_business_contract_path(@business, @contract), method: :post, class: "rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-500" %>
      <% end %>
      <% if @contract.draft? || @contract.sent? %>
        <%= button_to "Void", void_admin_business_contract_path(@business, @contract), method: :post, form: { data: { turbo_confirm: "Void this contract?" } }, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-200" %>
      <% end %>
    </div>
  </div>

  <div class="space-y-4 rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 text-sm text-slate-700">
    <div>
      <h2 class="font-semibold text-slate-900">Parties</h2>
      <p class="mt-1"><%= @contract.agency_name %> ↔ <%= @contract.client_name %> (<%= @contract.client_email %>)</p>
    </div>
    <% if @contract.amount_cents.present? %>
      <div>
        <h2 class="font-semibold text-slate-900">Amount</h2>
        <p class="mt-1"><%= number_to_currency(@contract.amount) %></p>
      </div>
    <% end %>
    <div>
      <h2 class="font-semibold text-slate-900">Scope</h2>
      <p class="mt-1 whitespace-pre-wrap"><%= @contract.scope_of_work %></p>
    </div>
    <div>
      <h2 class="font-semibold text-slate-900">Pricing</h2>
      <p class="mt-1 whitespace-pre-wrap"><%= @contract.pricing_terms %></p>
    </div>
    <div>
      <h2 class="font-semibold text-slate-900">Timeline</h2>
      <p class="mt-1 whitespace-pre-wrap"><%= @contract.timeline_terms %></p>
    </div>
    <div>
      <h2 class="font-semibold text-slate-900">Termination</h2>
      <p class="mt-1 whitespace-pre-wrap"><%= @contract.termination_terms %></p>
    </div>
    <% if @contract.signed? %>
      <div class="rounded-lg bg-emerald-50 p-4 text-emerald-900">
        <h2 class="font-semibold">Signed</h2>
        <p class="mt-1">Client: <%= @contract.client_signer_name %> at <%= l(@contract.client_signed_at, format: :long) %></p>
        <p>IP: <%= @contract.client_signer_ip %></p>
        <% if @contract.client_signature.attached? %>
          <div class="mt-3 rounded-lg border border-emerald-200 bg-white p-3">
            <%= image_tag @contract.client_signature, alt: "Client signature", class: "h-20 w-auto max-w-full object-contain" %>
          </div>
        <% end %>
        <p class="mt-2">Agency: <%= @contract.agency_signer_name %> at <%= l(@contract.agency_signed_at, format: :long) %></p>
      </div>
    <% elsif @contract.sent? %>
      <div class="rounded-lg bg-amber-50 p-4 text-amber-900">
        <p>Sign link: <%= link_to client_contract_url(@contract.access_token), client_contract_url(@contract.access_token), class: "underline break-all" %></p>
      </div>
    <% end %>
  </div>
</div>
