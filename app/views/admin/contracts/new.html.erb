<% content_for :title, "New contract · #{@business.name}" %>
<%
  default_kind = @contract.kind.presence || (@business.subscription_active? ? "subscription" : "one_time_project")
  subscription_payloads = Contracts::PackageCatalog::SUBSCRIPTION_PACKAGES.keys.index_with { |key|
    Contracts::PackageCatalog.subscription_payload(key, business: @business)
  }
  project_payloads = Contracts::PackageCatalog::PROJECT_PACKAGES.keys.index_with { |key|
    Contracts::PackageCatalog.project_payload(key, business: @business)
  }
  form_payloads = {
    "subscription" => subscription_payloads,
    "one_time_project" => project_payloads
  }
  field = "mt-1.5 block w-full rounded-lg border-0 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-blue-600"
  label = "block text-sm font-semibold text-slate-800"
  hint = "mt-1 text-xs leading-relaxed text-slate-500"
  section = "rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-900/5 sm:p-6"
%>

<div class="mx-auto max-w-3xl pb-10">
  <div class="mb-6">
    <%= link_to admin_business_path(@business), class: "inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 hover:text-blue-500" do %>
      <span aria-hidden="true">←</span> Back to <%= @business.name %>
    <% end %>
    <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">New client contract</h1>
    <p class="mt-1 max-w-2xl text-sm leading-relaxed text-slate-500">
      Choose the agreement type and package. Terms fill automatically — edit anything before you save.
    </p>
  </div>

  <%= form_with model: @contract,
        url: admin_business_contracts_path(@business),
        class: "space-y-5",
        data: { controller: "contract-form" } do |f| %>

    <script type="application/json" data-contract-form-target="payloads">
      <%= raw form_payloads.to_json %>
    </script>

    <%# ── Package ── %>
    <section class="<%= section %>">
      <div class="flex items-start gap-3 border-b border-slate-100 pb-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-sm font-bold text-blue-700">1</div>
        <div>
          <h2 class="text-base font-semibold text-slate-900">Package</h2>
          <p class="mt-0.5 text-sm text-slate-500">What the client is buying</p>
        </div>
      </div>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :kind, "Agreement type", class: label %>
          <%= f.select :kind,
                Contract::KINDS.map { |k, v| [v, k] },
                {},
                class: field,
                data: { contract_form_target: "kind", action: "change->contract-form#kindChanged" } %>
        </div>

        <div>
          <label class="<%= label %>" for="contract_package">Package</label>

          <select id="contract_package"
                  name="contract[package_key]"
                  class="<%= field %> <%= "hidden" unless default_kind == "subscription" %>"
                  data-contract-form-target="subscriptionPackages"
                  data-action="change->contract-form#packageChanged"
                  <%= "disabled" unless default_kind == "subscription" %>>
            <% Contracts::PackageCatalog.subscription_options.each do |opt_label, key| %>
              <option value="<%= key %>" <%= "selected" if key == @subscription_package_key %>><%= opt_label %></option>
            <% end %>
          </select>

          <select name="contract[package_key]"
                  class="<%= field %> <%= "hidden" if default_kind == "subscription" %>"
                  data-contract-form-target="projectPackages"
                  data-action="change->contract-form#packageChanged"
                  <%= "disabled" if default_kind == "subscription" %>>
            <% Contracts::PackageCatalog.project_options.each do |opt_label, key| %>
              <option value="<%= key %>" <%= "selected" if key == @project_package_key %>><%= opt_label %></option>
            <% end %>
          </select>
        </div>
      </div>

      <div data-contract-form-target="subscriptionFees" class="<%= "hidden" unless default_kind == "subscription" %> mt-5 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-sm text-slate-700">
        <p class="font-semibold text-slate-900">Fees from this business</p>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          <p>One-time setup: <span class="font-medium text-slate-900"><%= @business.sold_price.present? ? number_to_currency(@business.sold_price) : "Package default" %></span></p>
          <p>Monthly: <span class="font-medium text-slate-900"><%= @business.subscription_fee.present? ? number_to_currency(@business.subscription_fee) : "Package default" %></span></p>
        </div>
      </div>

      <div data-contract-form-target="projectFees" class="<%= "hidden" if default_kind == "subscription" %> mt-5 rounded-xl border border-violet-100 bg-violet-50/70 px-4 py-3 text-sm text-slate-700">
        <p class="font-semibold text-slate-900">Fee from this business</p>
        <p class="mt-2">Project / sold price: <span class="font-medium text-slate-900"><%= @business.sold_price.present? ? number_to_currency(@business.sold_price) : "Package default" %></span></p>
      </div>
    </section>

    <%# ── Parties ── %>
    <section class="<%= section %>">
      <div class="flex items-start gap-3 border-b border-slate-100 pb-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-sm font-bold text-blue-700">2</div>
        <div>
          <h2 class="text-base font-semibold text-slate-900">Parties & amount</h2>
          <p class="mt-0.5 text-sm text-slate-500">Who signs and the primary price shown on the contract</p>
        </div>
      </div>

      <div class="mt-5 space-y-5">
        <div>
          <%= f.label :title, class: label %>
          <%= f.text_field :title, class: field, data: { contract_form_target: "title" } %>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= f.label :client_name, class: label %>
            <%= f.text_field :client_name, class: field %>
          </div>
          <div>
            <%= f.label :client_email, class: label %>
            <%= f.email_field :client_email, class: field %>
          </div>
          <div>
            <%= f.label :agency_name, class: label %>
            <%= f.text_field :agency_name, class: field %>
          </div>
          <div>
            <label class="<%= label %>" for="contract_amount_dollars">Primary amount (USD)</label>
            <div class="relative mt-1.5">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-slate-400">$</span>
              <input id="contract_amount_dollars" name="contract[amount_dollars]" type="number" step="0.01" min="0"
                     value="<%= @contract.amount %>"
                     class="<%= field %> !pl-7"
                     data-contract-form-target="amount"
                     placeholder="0.00" />
            </div>
            <p class="<%= hint %>">Monthly fee for subscriptions · project fee for one-time builds</p>
          </div>
        </div>
      </div>
    </section>

    <%# ── Terms ── %>
    <section class="<%= section %>">
      <div class="flex items-start gap-3 border-b border-slate-100 pb-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-sm font-bold text-blue-700">3</div>
        <div>
          <h2 class="text-base font-semibold text-slate-900">Contract terms</h2>
          <p class="mt-0.5 text-sm text-slate-500">Auto-filled from the package — edit if this deal differs</p>
        </div>
      </div>

      <div class="mt-5 space-y-5">
        <div>
          <%= f.label :scope_of_work, "Scope of work", class: label %>
          <%= f.text_area :scope_of_work, rows: 8, class: "#{field} leading-relaxed", data: { contract_form_target: "scope" } %>
        </div>
        <div>
          <%= f.label :pricing_terms, "Pricing terms", class: label %>
          <%= f.text_area :pricing_terms, rows: 5, class: "#{field} leading-relaxed", data: { contract_form_target: "pricing" } %>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= f.label :timeline_terms, "Timeline", class: label %>
            <%= f.text_area :timeline_terms, rows: 4, class: "#{field} leading-relaxed", data: { contract_form_target: "timeline" } %>
          </div>
          <div>
            <%= f.label :termination_terms, "Termination", class: label %>
            <%= f.text_area :termination_terms, rows: 4, class: "#{field} leading-relaxed", data: { contract_form_target: "termination" } %>
          </div>
        </div>
      </div>
    </section>

    <div class="sticky bottom-4 z-10 flex flex-col-reverse gap-3 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-lg backdrop-blur sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-slate-500">You can send for signature after saving this draft.</p>
      <div class="flex gap-3">
        <%= link_to "Cancel", admin_business_path(@business), class: "inline-flex flex-1 items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-700 ring-1 ring-inset ring-slate-200 hover:bg-slate-50 sm:flex-none" %>
        <%= f.submit "Save draft", class: "inline-flex flex-1 cursor-pointer items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 sm:flex-none" %>
      </div>
    </div>
  <% end %>
</div>
