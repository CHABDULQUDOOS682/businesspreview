<div class="bg-white shadow-sm ring-1 ring-slate-900/5 sm:rounded-xl p-4 sm:p-5 space-y-4 overflow-hidden">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
    <h3 class="text-base font-semibold leading-6 text-slate-900">Notes</h3>
    <p class="text-xs text-slate-500">
      Internal notes about <%= business.name %>
    </p>
  </div>

  <% if business.notes.any? %>
    <ul class="space-y-3">
      <% business.notes.order(created_at: :desc).each do |note| %>
        <li class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm leading-6 text-slate-800">
          <p class="whitespace-pre-wrap break-words [overflow-wrap:anywhere]"><%= note.body %></p>

          <div class="mt-2 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
            <p class="min-w-0 text-[10px] text-slate-400">
              By <span class="font-medium text-slate-600"><%= note.creator_name %></span>
              (<%= note.creator_role %>)
              <span class="text-slate-300">·</span>
              <span class="text-slate-500"><%= time_ago_in_words(note.created_at) %> ago</span>
            </p>

            <div class="flex shrink-0 items-center gap-2">
              <%= link_to "Edit",
                          edit_admin_note_path(note),
                          class: "text-xs font-medium text-blue-600 hover:text-blue-500" %>
              <span class="text-slate-300 text-xs" aria-hidden="true">·</span>
              <%= button_to "Delete",
                            admin_note_path(note),
                            method: :delete,
                            data: { turbo_confirm: "Delete this note?" },
                            class: "text-xs font-medium text-red-600 hover:text-red-500 bg-transparent border-0 p-0" %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-slate-500">
      No notes yet. Use the form below to add your first note.
    </p>
  <% end %>

  <div class="pt-3 border-t border-slate-200">
    <%= render "admin/notes/form", note: Note.new(business: business), business: business %>
  </div>
</div>
