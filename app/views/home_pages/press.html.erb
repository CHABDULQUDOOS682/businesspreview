<% content_for :title, "Press Kit | DevDeBizz" %>
<% content_for :meta_description, "Official brand assets, logos, and company information for media, partners, and press inquiries." %>

<%= render "page_header",
  eyebrow: "Press",
  title_html: 'Official brand assets for <span class="home-display-accent">media & partners</span>'.html_safe,
  subtitle: "Use these guidelines and logos when featuring DevDeBizz in articles, directories, or partnership announcements." %>

<section class="py-20">
  <div class="mx-auto max-w-7xl px-2 md:px-0">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5 home-glass home-card-3d rounded-[32px] p-8 md:p-10">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#213885]">Company facts</p>
        <dl class="mt-6 space-y-4 text-sm">
          <div class="flex justify-between gap-4 border-b border-[#081849]/10 pb-3">
            <dt class="text-[#081849]/55">Company</dt>
            <dd class="font-semibold text-[#081849] text-right">DevDeBizz</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-[#081849]/10 pb-3">
            <dt class="text-[#081849]/55">Focus</dt>
            <dd class="font-semibold text-[#081849] text-right">Websites, SEO & lead systems for service businesses</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-[#081849]/10 pb-3">
            <dt class="text-[#081849]/55">Founded</dt>
            <dd class="font-semibold text-[#081849] text-right"><%= founded_year %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-[#081849]/55">Press contact</dt>
            <dd class="font-semibold text-[#081849] text-right"><%= mail_to contact_email, contact_email, class: "underline" %></dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-7 space-y-6">
        <div class="home-glass home-card-3d rounded-[32px] p-8">
          <h2 class="text-2xl font-bold text-[#081849]">Brand assets</h2>
          <p class="mt-2 text-sm text-[#081849]/65">Download official logos from the Brand Kit. For usage questions or custom formats, email press contact.</p>
          <div class="mt-6">
            <%= link_to "Open Brand Kit", brand_kit_path, class: "home-btn-primary inline-flex px-6 py-3 text-sm" %>
          </div>
        </div>

        <div class="home-glass home-card-3d rounded-[32px] p-8">
          <h2 class="text-2xl font-bold text-[#081849]">Boilerplate</h2>
          <p class="mt-4 text-sm leading-relaxed text-[#081849]/75">
            DevDeBizz builds conversion-focused websites, search visibility, booking systems, and follow-up automation for service businesses.
            We help owners turn website traffic into booked jobs with clear CTAs, mobile-first design, and practical lead workflows.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
