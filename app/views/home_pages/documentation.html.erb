<% content_for :title, "Documentation | DevDeBizz" %>
<% content_for :meta_description, "Guides for DevDeBizz clients covering onboarding, billing, and project delivery support." %>

<%= render "page_header",
  eyebrow: "Docs",
  title_html: 'Client guides and <span class="home-display-accent">project support</span>'.html_safe,
  subtitle: "Start with Help Center answers, or contact us for project-specific documentation." %>

<section class="py-20">
  <div class="mx-auto max-w-7xl px-2 md:px-0">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="home-glass home-card-3d rounded-[28px] p-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#213885]">Getting started</p>
        <h2 class="mt-3 text-xl font-bold text-[#081849]">Help Center</h2>
        <p class="mt-2 text-sm text-[#081849]/65">Answers on timelines, packages, SEO, bookings, and follow-up systems.</p>
        <%= link_to "Open Help Center →", help_center_path, class: "mt-5 inline-flex text-sm font-semibold text-[#213885]" %>
      </div>
      <div class="home-glass home-card-3d rounded-[28px] p-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#213885]">Billing</p>
        <h2 class="mt-3 text-xl font-bold text-[#081849]">Invoices & payments</h2>
        <p class="mt-2 text-sm text-[#081849]/65">How Stripe invoice links work for deposits and milestone payments.</p>
        <%= link_to "Billing FAQ →", help_center_path, class: "mt-5 inline-flex text-sm font-semibold text-[#213885]" %>
      </div>
      <div class="home-glass home-card-3d rounded-[28px] p-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#213885]">Support</p>
        <h2 class="mt-3 text-xl font-bold text-[#081849]">Project questions</h2>
        <p class="mt-2 text-sm text-[#081849]/65">Need a walkthrough of your site, booking flow, or SEO setup? Reach out.</p>
        <%= link_to "Contact us →", contact_path, class: "mt-5 inline-flex text-sm font-semibold text-[#213885]" %>
      </div>
    </div>
  </div>
</section>
