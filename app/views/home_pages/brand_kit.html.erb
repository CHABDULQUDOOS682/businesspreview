<% content_for :title, "Brand Kit | DevDeBizz" %>
<% content_for :meta_description, "Download the DevDeBizz brand kit—official logos and usage notes for press, partners, and collaborations. Keep marks consistent." %>

<%= render "page_header",
  eyebrow: "Brand",
  title_html: 'Official logos and <span class="home-display-accent">brand assets</span>'.html_safe,
  subtitle: "Use these files for partnerships, directories, and media mentions. Do not alter colors or proportions." %>

<section class="py-20">
  <div class="mx-auto max-w-7xl px-2 md:px-0">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="home-glass home-card-3d rounded-[28px] p-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#213885]">Primary mark</p>
        <h2 class="mt-3 text-xl font-bold text-[#081849]">Website icon SVG</h2>
        <p class="mt-2 text-sm text-[#081849]/65">Primary brand mark for web and digital use.</p>
        <%= link_to "Download SVG",
              asset_path("logo/Website Icon logo SVG 512x512.svg"),
              download: "devdebizz-icon-512.svg",
              class: "mt-5 inline-flex text-sm font-semibold text-[#213885] underline" %>
      </div>
      <div class="home-glass home-card-3d rounded-[28px] p-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#213885]">Alternate</p>
        <h2 class="mt-3 text-xl font-bold text-[#081849]">Normal icon SVG</h2>
        <p class="mt-2 text-sm text-[#081849]/65">Alternate icon for compact placements.</p>
        <%= link_to "Download SVG",
              asset_path("logo/Normal Icon SVG.svg"),
              download: "devdebizz-icon.svg",
              class: "mt-5 inline-flex text-sm font-semibold text-[#213885] underline" %>
      </div>
      <div class="home-glass home-card-3d rounded-[28px] p-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#213885]">Favicon</p>
        <h2 class="mt-3 text-xl font-bold text-[#081849]">Favicon SVG</h2>
        <p class="mt-2 text-sm text-[#081849]/65">Small mark for browser tabs and app icons.</p>
        <%= link_to "Download SVG",
              asset_path("logo/Fav-Icon 49x49.svg"),
              download: "devdebizz-favicon.svg",
              class: "mt-5 inline-flex text-sm font-semibold text-[#213885] underline" %>
      </div>
    </div>

    <div class="mt-10 home-glass home-card-3d rounded-[32px] p-8 md:p-10">
      <h2 class="text-2xl font-bold text-[#081849]">Usage notes</h2>
      <ul class="mt-4 space-y-2 text-sm text-[#081849]/70 list-disc pl-5">
        <li>Keep clear space around the mark equal to the icon height.</li>
        <li>Do not recolor, stretch, or add effects to the logo.</li>
        <li>Prefer the primary mark on light backgrounds.</li>
        <li>Questions? Email <%= mail_to contact_email, contact_email, class: "font-semibold underline text-[#213885]" %>.</li>
      </ul>
    </div>
  </div>
</section>
