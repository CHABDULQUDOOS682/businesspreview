<section class="pb-20 pt-4">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%# Path chooser %>
    <div class="mb-16">
      <p class="text-center text-xs font-bold uppercase tracking-[0.18em] text-[#5F3475]">Two ways to work with us</p>
      <h2 class="mt-3 text-center text-3xl font-extrabold text-[#081849] md:text-4xl">Choose the path that fits</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-sm leading-relaxed text-[#081849]/65">
        Both options are shown on this page — nothing is hidden. Pick monthly support or a one-time build.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <a href="#monthly-plans" class="home-glass home-card-3d group rounded-[28px] border border-[#081849]/10 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#213885]/35">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#213885]/10 text-[#213885]">
            <i class="fa-regular fa-calendar-check text-xl"></i>
          </div>
          <h3 class="mt-5 text-2xl font-bold text-[#081849]">Monthly partnership</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#081849]/65">Hosting, SEO, updates, and ongoing support — from $30/month.</p>
          <ul class="mt-5 space-y-2 text-sm text-[#081849]/80">
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-xs text-[#213885]"></i>Predictable monthly investment</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-xs text-[#213885]"></i>Ongoing updates & monitoring</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-xs text-[#213885]"></i>Scales as your business grows</li>
          </ul>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[#213885] group-hover:gap-3 transition-all">
            View plans below <i class="fa-solid fa-arrow-down text-xs"></i>
          </span>
        </a>

        <a href="#project-plans" class="home-glass home-card-3d group rounded-[28px] border border-[#081849]/10 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#5F3475]/35">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#5F3475]/10 text-[#5F3475]">
            <i class="fa-solid fa-laptop-code text-xl"></i>
          </div>
          <h3 class="mt-5 text-2xl font-bold text-[#081849]">One-time project</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#081849]/65">We design and build your site, then hand it off — from $199.</p>
          <ul class="mt-5 space-y-2 text-sm text-[#081849]/80">
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-xs text-[#5F3475]"></i>Fixed project investment</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-xs text-[#5F3475]"></i>Clear scope & delivery timeline</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-xs text-[#5F3475]"></i>Launch with confidence</li>
          </ul>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[#5F3475] group-hover:gap-3 transition-all">
            View project options below <i class="fa-solid fa-arrow-down text-xs"></i>
          </span>
        </a>
      </div>
    </div>

    <%# Monthly partnership plans %>
    <div id="monthly-plans" class="scroll-mt-28">
      <div class="mb-8 max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#213885]">Monthly partnership</p>
        <h2 class="mt-2 text-3xl font-extrabold text-[#081849] md:text-4xl">Subscription plans</h2>
        <p class="mt-3 text-sm leading-relaxed text-[#081849]/65">Hosting, SEO, updates, and a web partner every month.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <% subscription_plans.each do |plan| %>
          <%= render "home_pages/pricing_subscription_card", plan: plan %>
        <% end %>
      </div>
    </div>

    <%# Subscription comparison %>
    <div class="mt-20">
      <h2 class="text-center text-3xl font-extrabold text-[#081849] md:text-4xl">Compare <span class="text-[#5F3475]">monthly features</span></h2>
      <div class="mt-10 overflow-x-auto rounded-[28px] border border-[#081849]/10 bg-white/40 shadow-[0_18px_45px_rgba(8,24,73,0.06)]">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-[#081849]/10 bg-[#213885] text-left text-[#ECDFD2]">
              <th class="px-6 py-4 font-semibold">Feature</th>
              <th class="px-6 py-4 text-center font-semibold">Essential</th>
              <th class="px-6 py-4 text-center font-semibold">Growth</th>
              <th class="px-6 py-4 text-center font-semibold">Business Pro</th>
            </tr>
          </thead>
          <tbody class="text-[#081849]/80">
            <% subscription_comparison.each_with_index do |(feature, essential, growth, pro), index| %>
              <tr class="border-b border-[#081849]/5 <%= index.even? ? 'bg-white/50' : 'bg-[#213885]/[0.03]' %>">
                <td class="px-6 py-4 font-medium text-[#081849]"><%= feature %></td>
                <% [essential, growth, pro].each do |value| %>
                  <td class="px-6 py-4 text-center"><%= render_value.call(value) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Project plans %>
    <div id="project-plans" class="mt-24 scroll-mt-28">
      <div class="mb-8 max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#5F3475]">One-time project builds</p>
        <h2 class="mt-2 text-3xl font-extrabold text-[#081849] md:text-4xl">Project packages</h2>
        <p class="mt-3 text-sm leading-relaxed text-[#081849]/65">Pay once for a designed, built, and launched website or custom app.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <% project_plans.each do |plan| %>
          <%= render "home_pages/pricing_project_card", plan: plan %>
        <% end %>
      </div>
    </div>

    <%# Project comparison %>
    <div class="mt-20">
      <h2 class="text-center text-3xl font-extrabold text-[#081849] md:text-4xl">Compare <span class="text-[#5F3475]">project features</span></h2>
      <div class="mt-10 overflow-x-auto rounded-[28px] border border-[#081849]/10 bg-white/40 shadow-[0_18px_45px_rgba(8,24,73,0.06)]">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-[#081849]/10 bg-[#5F3475] text-left text-[#ECDFD2]">
              <th class="px-6 py-4 font-semibold">Feature</th>
              <th class="px-6 py-4 text-center font-semibold">Starter</th>
              <th class="px-6 py-4 text-center font-semibold">Growth</th>
              <th class="px-6 py-4 text-center font-semibold">Custom</th>
            </tr>
          </thead>
          <tbody class="text-[#081849]/80">
            <% project_comparison.each_with_index do |(feature, starter, growth, custom), index| %>
              <tr class="border-b border-[#081849]/5 <%= index.even? ? 'bg-white/50' : 'bg-[#5F3475]/[0.03]' %>">
                <td class="px-6 py-4 font-medium text-[#081849]"><%= feature %></td>
                <% [starter, growth, custom].each do |value| %>
                  <td class="px-6 py-4 text-center"><%= render_value.call(value) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# FAQ %>
    <div class="mt-24">
      <h2 class="text-center text-3xl font-extrabold text-[#081849] md:text-4xl">Frequently asked <span class="text-[#5F3475]">questions</span></h2>
      <div class="mt-10 grid gap-3 md:grid-cols-2">
        <% faqs.each_with_index do |(question, answer), index| %>
          <details class="overflow-hidden rounded-[22px] border border-[#081849]/10 bg-white/35" <%= "open" if index.zero? %>>
            <summary class="cursor-pointer list-none px-6 py-5 font-semibold text-[#081849] marker:hidden">
              <div class="flex items-center justify-between gap-4">
                <span><%= question %></span>
                <span class="text-xl text-[#5F3475]">+</span>
              </div>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-[#081849]/68"><%= answer %></div>
          </details>
        <% end %>
      </div>
    </div>

    <%# Mid-page CTA (not site footer) %>
    <div class="mt-24 overflow-hidden rounded-[28px] bg-gradient-to-br from-[#213885] via-[#5F3475] to-[#893172] p-8 text-[#ECDFD2] shadow-2xl md:p-10">
      <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
        <div class="max-w-xl">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10">
            <i class="fa-regular fa-calendar-check text-xl"></i>
          </div>
          <h2 class="text-2xl font-extrabold md:text-3xl">Ready to build something great?</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#ECDFD2]/78">
            Tell us your goals and we’ll help you choose monthly partnership or a one-time project.
          </p>
        </div>
        <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          <%= link_to schedule_path, class: "inline-flex items-center justify-center rounded-full border border-[#ECDFD2]/40 px-6 py-3 text-sm font-bold text-[#ECDFD2] transition hover:bg-white/10" do %>
            Book a call
          <% end %>
          <%= link_to contact_path, class: "inline-flex items-center justify-center rounded-full bg-[#ECDFD2] px-6 py-3 text-sm font-bold text-[#213885] shadow-xl shadow-[#081849]/25 transition hover:bg-white" do %>
            Start a project
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
